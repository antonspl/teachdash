# Every variable the compose files read. The backend connects with the POSTGRES_* values,
# so the database credentials have one source.
# Local dev values live in infra/dev.env; to override one, copy its line to a root .env
# (gitignored) with your value.
# Production sets all of them except BACKEND_UPSTREAM, which has a default in
# infra/docker-compose.yml.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# First admin, created at start only if no admin exists
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Base URL for set-password links (the frontend)
APP_BASE_URL=

# Where the web container proxies /api/*. Optional; the default is the compose backend service.
BACKEND_UPSTREAM=backend:8080
