# Optional overrides for the local run (compose has the same defaults). Copy to .env (gitignored): cp .env.example .env
POSTGRES_DB=teachdash
POSTGRES_USER=teachdash
POSTGRES_PASSWORD=teachdash-dev

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/teachdash
SPRING_DATASOURCE_USERNAME=teachdash
SPRING_DATASOURCE_PASSWORD=teachdash-dev

# First admin, created at start only if no admin exists
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-dev-password
ADMIN_NAME=Admin

# Base URL for set-password links (the frontend)
APP_BASE_URL=http://localhost:5173
