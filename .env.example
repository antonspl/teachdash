# Every variable the app and the compose files read. Local dev values live in
# infra/dev.env; to override one, copy its line to a root .env (gitignored) with your value.
# Production sets all of them (see infra/docker-compose.yml, which has no defaults).
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# First admin, created at start only if no admin exists
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Base URL for set-password links (the frontend)
APP_BASE_URL=
