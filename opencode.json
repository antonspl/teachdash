{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "scripts/setup-agents *", "effect": "allow" },
    { "action": "shell", "resource": "scripts/flow/issue-brief *", "effect": "allow" },
    { "action": "shell", "resource": "scripts/flow/change-start *", "effect": "allow" },
    { "action": "shell", "resource": "scripts/flow/pr-draft *", "effect": "allow" },
    { "action": "shell", "resource": "scripts/flow/pr-ready *", "effect": "allow" },
    { "action": "shell", "resource": "scripts/flow/gate-request *", "effect": "allow" },
    { "action": "shell", "resource": "scripts/flow/gate-status *", "effect": "allow" },
    { "action": "shell", "resource": "scripts/flow/test *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git push --force", "effect": "deny" },
    { "action": "shell", "resource": "git push --force *", "effect": "deny" },
    { "action": "shell", "resource": "git push * --force", "effect": "deny" },
    { "action": "shell", "resource": "git push * --force *", "effect": "deny" },
    { "action": "shell", "resource": "git push -f", "effect": "deny" },
    { "action": "shell", "resource": "git push -f *", "effect": "deny" },
    { "action": "shell", "resource": "git push * -f", "effect": "deny" },
    { "action": "shell", "resource": "git push * -f *", "effect": "deny" },
    { "action": "shell", "resource": "git push * main", "effect": "deny" },
    { "action": "shell", "resource": "git push * main *", "effect": "deny" },
    { "action": "shell", "resource": "git push *:main", "effect": "deny" },
    { "action": "shell", "resource": "git push *:main *", "effect": "deny" },
    { "action": "shell", "resource": "git push * HEAD:main", "effect": "deny" },
    { "action": "shell", "resource": "git push * HEAD:main *", "effect": "deny" },
    { "action": "shell", "resource": "git push * +main", "effect": "deny" },
    { "action": "shell", "resource": "git push * +main *", "effect": "deny" },
    { "action": "shell", "resource": "git push * +*", "effect": "deny" },
    { "action": "shell", "resource": "git push * +* *", "effect": "deny" },
    { "action": "shell", "resource": "git push * refs/heads/main", "effect": "deny" },
    { "action": "shell", "resource": "git push * refs/heads/main *", "effect": "deny" },
    { "action": "shell", "resource": "git push *:refs/heads/main", "effect": "deny" },
    { "action": "shell", "resource": "git push *:refs/heads/main *", "effect": "deny" }
  ]
}
