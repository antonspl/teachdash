    { "action": "edit", "resource": "./scripts/setup-agents", "effect": "ask" },
    { "action": "edit", "resource": ".agents/roles/**", "effect": "ask" },
    { "action": "edit", "resource": "./.agents/roles/**", "effect": "ask" },
