#!/usr/bin/env bash
# Creates the change branch from an updated main and the OpenSpec change.
# Run it from a checkout; it does not need to be on main.
# Usage: scripts/flow/change-start <name> <issue>
set -euo pipefail
# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"

[ $# -eq 2 ] || die "usage: change-start <name> <issue>"
name=$1
[[ $name =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "name must be kebab-case"
[[ $2 =~ ^[0-9]+$ ]] || die "issue must be a number"

git symbolic-ref -q HEAD >/dev/null || die "detached HEAD, check out a branch first"
git show-ref --verify --quiet "refs/heads/$name" && die "branch $name already exists"

if ! "$(dirname "$0")/../setup-agents" --check >/dev/null; then
  echo "warning: agent files are stale, run scripts/setup-agents and restart the session" >&2
fi

git fetch --quiet origin main
git switch --quiet --no-track -c "$name" origin/main
openspec new change "$name" >/dev/null
echo "branch $name from origin/main, change openspec/changes/$name/ (issue #$2)"
