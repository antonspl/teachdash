#!/usr/bin/env bash
# Reports, for each gate, the latest approving comment, the box and staleness.
# Only reports; the engineer decides. Never ticks or approves anything.
# Usage: scripts/flow/gate-status [pr]
# With FLOW_GH_JSON=<file> (needs jq), runs the same filters as live mode on a
# saved {"pr", "comments", "reviews"} file. See scripts/flow/test.
#
# Extracted format, one line per item, tab separated:
#   N <number>                 the PR number
#   H <branch>                 the PR head branch (live mode only)
#   A <login>                  the PR author
#   B <gate> <x|space>         gate box from the description
#   T <time>                   committer date of one commit, one line per commit
#   C <login> <time> <first line of a comment or review body>
set -euo pipefail
# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"

[ $# -eq 0 ] || require_number "$1" "pr number"

# The same filters run live and on the fixtures: head uses the field names of
# `gh pr view --json`, commits, comments and reviews those of the REST API.
# shellcheck disable=SC2016 # the backticks are code fences in a jq regex
FILTER_HEAD='
  "N\t" + (.number | tostring),
  "H\t" + (.headRefName // ""),
  "A\t" + ((.author.login // "") | if . == "" then "ghost" else . end),
  (.body // "" | gsub("(^|\n) {0,3}```[\\s\\S]*?(\n {0,3}```[^\n]*|\\z)"; "\n")
    | gsub("(^|\n) {0,3}~~~[\\s\\S]*?(\n {0,3}~~~[^\n]*|\\z)"; "\n")
    | gsub("<!--[\\s\\S]*?(-->|\\z)"; "")
    | split("\n")[]
    | capture("^- \\[(?<box>[ xX])\\] (?<gate>Spec|Tests|Code) approved")?
    | "B\t" + (.gate | ascii_downcase) + "\t" + (if .box == " " then "space" else "x" end))'

FILTER_COMMITS='.[] | .commit.committer.date // empty | "T\t" + .'

FILTER_COMMENTS='.[]
  | "C\t" + ((.user.login // "") | if . == "" then "ghost" else . end) + "\t" + .created_at + "\t"
    + (.body // "" | split("\n") | .[0] // "" | rtrimstr("\r") | gsub("\t"; " "))'

FILTER_REVIEWS='.[]
  | select(.state != "PENDING" and .state != "DISMISSED" and .state != "CHANGES_REQUESTED" and .submitted_at != null)
  | "C\t" + ((.user.login // "") | if . == "" then "ghost" else . end) + "\t" + .submitted_at + "\t"
    + (.body // "" | split("\n") | .[0] // "" | rtrimstr("\r") | gsub("\t"; " "))'

extract() {
  if [ -n "${FLOW_GH_JSON:-}" ]; then
    jq -r ".pr | $FILTER_HEAD" "$FLOW_GH_JSON" &&
      jq -r ".commits // [] | $FILTER_COMMITS" "$FLOW_GH_JSON" &&
      jq -r ".comments | $FILTER_COMMENTS" "$FLOW_GH_JSON" &&
      jq -r ".reviews | $FILTER_REVIEWS" "$FLOW_GH_JSON"
  else
    local head number
    head=$(gh pr view ${1:+"$1"} --json number,author,body,headRefName --jq "$FILTER_HEAD") || return 1
    number=$(printf '%s\n' "$head" | awk -F'\t' '$1 == "N" { print $2 }')
    printf '%s\n' "$head"
    # The REST endpoints are paginated; `gh pr view` returns only the first page.
    gh api --paginate "repos/{owner}/{repo}/pulls/$number/commits" --jq "$FILTER_COMMITS" &&
      gh api --paginate "repos/{owner}/{repo}/issues/$number/comments" --jq "$FILTER_COMMENTS" &&
      gh api --paginate "repos/{owner}/{repo}/pulls/$number/reviews" --jq "$FILTER_REVIEWS"
  fi
}

data=$(extract "${1:-}") || die "could not read the pull request from GitHub (no PR, gh logged out or no network)"

# Live mode only: one line on how the branch stands against its upstream.
# Never fails, so a git problem cannot hide the gate lines.
branch_line() {
  local head=$1 branch up rc=0 counts ahead behind
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "branch: unknown (not a git checkout)"
    return 0
  fi
  if ! branch=$(git symbolic-ref --short HEAD 2>/dev/null); then
    echo "branch: detached HEAD"
    return 0
  fi
  if [ -n "$head" ] && [ "$branch" != "$head" ]; then
    echo "branch: not the PR branch"
    return 0
  fi
  up=$(fetch_upstream) || rc=$?
  case $rc in
    1) echo "branch: no upstream" ;;
    2) echo "branch: unknown (fetch failed)" ;;
    *)
      counts=$(git rev-list --left-right --count "HEAD...$up" 2>/dev/null) || { echo "branch: unknown (fetch failed)"; return 0; }
      read -r ahead behind <<<"$counts"
      if [ "$ahead" = 0 ] && [ "$behind" = 0 ]; then
        echo "branch: in sync with upstream"
      else
        echo "branch: $ahead unpushed, $behind behind upstream"
      fi
      ;;
  esac
}

if [ -z "${FLOW_GH_JSON:-}" ]; then
  branch_line "$(printf '%s\n' "$data" | awk -F'\t' '$1 == "H" { print $2 }')"
fi

printf '%s\n' "$data" | awk -F'\t' -v marker="$MARKER" '
  BEGIN { n = split("spec tests code", gates, " ") }
  $1 == "A" { author = $2 }
  $1 == "B" { box[$2] = ($3 == "x") }
  $1 == "T" { commits[++ncommits] = $2 }
  # Times are ISO 8601 UTC, so string comparison orders them; input order does not matter.
  $1 == "C" {
    text = tolower($4)
    is_flow = (index($4, marker) == 1)
    is_question = (text ~ /\?[ \t\r]*$/)
    for (i = 1; i <= n; i++) {
      g = gates[i]
      if (is_flow) {
        if (text ~ ("^" tolower(marker) " " g " gate") && $3 > requested[g]) requested[g] = $3
      } else if (!is_question && text ~ ("^[ ]*" g " approved") && $3 >= when[g]) {
        who[g] = $2
        when[g] = $3
      }
    }
  }
  END {
    for (i = 1; i <= n; i++) {
      g = gates[i]
      line = sprintf("%-6s", g ":")
      if (who[g] != "") line = line " approved by " who[g] ((author != "" && who[g] != author) ? " (not the PR author)" : "") " at " when[g]
      else line = line " no approving comment"
      line = line "; box " (box[g] ? "ticked" : "not ticked")
      if (who[g] != "" && requested[g] != "" && requested[g] >= when[g]) line = line "; STALE, approval is older than the latest request"
      else if (who[g] == "" && box[g]) line = line "; box ticked without a comment"
      else if (who[g] != "" && !box[g]) line = line "; comment without a ticked box"
      if (g == "code" && who[g] != "") {
        after = 0
        for (k = 1; k <= ncommits; k++) if (commits[k] > when[g]) after++
        if (after > 0) line = line "; " after " commit" (after > 1 ? "s" : "") " after the approval"
      }
      print line
    }
  }'
