#!/usr/bin/env bash
# Reports, for each gate, the latest approving comment, the box and staleness.
# Only reports; the engineer decides. Never ticks or approves anything.
# Usage: scripts/flow/gate-status [pr]
# With FLOW_GH_FIXTURE=<file>, reads the extracted PR lines from the file
# instead of calling gh; with FLOW_GH_JSON=<file>, runs the same filter on a
# saved `gh pr view --json` result (needs jq). See scripts/flow/test.
#
# Extracted format, one line per item, tab separated:
#   A <login>                  the PR author
#   B <gate> <x|space>         gate box from the description
#   C <login> <time> <first line of a comment or review body>
set -euo pipefail
# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"

[ $# -eq 0 ] || require_number "$1" "pr number"

FILTER='
  "A\t" + ((.author.login // "") | if . == "" then "ghost" else . end),
  (.body // "" | split("\n")[]
    | capture("^- \\[(?<box>[ xX])\\] (?<gate>Spec|Tests|Code) approved")?
    | "B\t" + (.gate | ascii_downcase) + "\t" + (if .box == " " then "space" else "x" end)),
  (.comments[]
    | "C\t" + ((.author.login // "") | if . == "" then "ghost" else . end) + "\t" + .createdAt + "\t"
      + (.body // "" | split("\n") | .[0] // "" | rtrimstr("\r") | gsub("\t"; " "))),
  (.reviews[]
    | select(.state != "PENDING" and .state != "DISMISSED" and .submittedAt != null)
    | "C\t" + ((.author.login // "") | if . == "" then "ghost" else . end) + "\t" + .submittedAt + "\t"
      + (.body // "" | split("\n") | .[0] // "" | rtrimstr("\r") | gsub("\t"; " ")))'

# Live mode reads head, comments and reviews separately (REST field names).
FILTER_HEAD='
  "A\t" + ((.author.login // "") | if . == "" then "ghost" else . end),
  (.body // "" | split("\n")[]
    | capture("^- \\[(?<box>[ xX])\\] (?<gate>Spec|Tests|Code) approved")?
    | "B\t" + (.gate | ascii_downcase) + "\t" + (if .box == " " then "space" else "x" end))'

FILTER_COMMENTS='.[]
  | "C\t" + ((.user.login // "") | if . == "" then "ghost" else . end) + "\t" + .created_at + "\t"
    + (.body // "" | split("\n") | .[0] // "" | rtrimstr("\r") | gsub("\t"; " "))'

FILTER_REVIEWS='.[]
  | select(.state != "PENDING" and .state != "DISMISSED" and .submitted_at != null)
  | "C\t" + ((.user.login // "") | if . == "" then "ghost" else . end) + "\t" + .submitted_at + "\t"
    + (.body // "" | split("\n") | .[0] // "" | rtrimstr("\r") | gsub("\t"; " "))'

extract() {
  if [ -n "${FLOW_GH_FIXTURE:-}" ]; then
    cat "$FLOW_GH_FIXTURE"
  elif [ -n "${FLOW_GH_JSON:-}" ]; then
    jq -r "$FILTER" "$FLOW_GH_JSON"
  else
    local number
    number=$(gh pr view ${1:+"$1"} --json number --jq .number) || return 1
    # The REST endpoints are paginated; `gh pr view` returns only the first page.
    gh pr view "$number" --json author,body --jq "$FILTER_HEAD" &&
      gh api --paginate "repos/{owner}/{repo}/issues/$number/comments" --jq "$FILTER_COMMENTS" &&
      gh api --paginate "repos/{owner}/{repo}/pulls/$number/reviews" --jq "$FILTER_REVIEWS"
  fi
}

data=$(extract "${1:-}") || die "could not read the pull request from GitHub (no PR, gh logged out or no network)"

printf '%s\n' "$data" | awk -F'\t' -v marker="$MARKER" '
  BEGIN { n = split("spec tests code", gates, " ") }
  $1 == "A" { author = $2 }
  $1 == "B" { box[$2] = ($3 == "x") }
  # Times are ISO 8601 UTC, so string comparison orders them; input order does not matter.
  $1 == "C" {
    text = tolower($4)
    is_flow = (index($4, marker) == 1)
    for (i = 1; i <= n; i++) {
      g = gates[i]
      if (is_flow) {
        if (text ~ ("^" tolower(marker) " " g " gate") && $3 > requested[g]) requested[g] = $3
      } else if (text ~ ("^[ ]*" g " approved") && $3 >= when[g]) {
        who[g] = $2
        when[g] = $3
      }
    }
  }
  END {
    for (i = 1; i <= n; i++) {
      g = gates[i]
      line = sprintf("%-6s", g ":")
      if (who[g] != "") line = line " approved by " who[g] ((author != "" && who[g] != author) ? " (not the PR author)" : "") " at " when[g]
      else line = line " no approving comment"
      line = line "; box " (box[g] ? "ticked" : "not ticked")
      if (who[g] != "" && requested[g] != "" && requested[g] > when[g]) line = line "; STALE, approval is older than the latest request"
      else if (who[g] == "" && box[g]) line = line "; box ticked without a comment"
      else if (who[g] != "" && !box[g]) line = line "; comment without a ticked box"
      print line
    }
  }'
